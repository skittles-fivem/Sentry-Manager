# Sentry Six Manager on this Mac: the same keys as the Docker .env file.
# install.sh writes this file once, as
#   /Library/Application Support/SentrySixManager/manager.env
# and never overwrites it. Edit it as an administrator, for example with
#   sudo nano "/Library/Application Support/SentrySixManager/manager.env"
# then run: sudo sentry-six-manager restart
# Everything is optional: vehicles, shares and the account are all managed in
# the web interface. The program and data folders are fixed and cannot be
# moved from here.

# Time zone (policy run times, logs). Empty: the Mac's own time zone.
# TZ=America/Chicago

# Port for the web interface (HTTPS, and plain HTTP that sends you on).
# PORT=9000

# Create the account on first start instead of with the setup code
# (sudo sentry-six-manager setup-code).
# UI_USERNAME=admin
# UI_PASSWORD=change-me

# HTTPS: the names / IP addresses you use to reach this Mac, so the
# certificate covers them (more can be added in Settings > Security).
# TLS_HOSTNAMES=192.168.1.20,my-mac.local
# Your own certificate instead of the built-in local CA (files the
# _sentrysix account can read):
# TLS_CERT_FILE=/Library/Application Support/SentrySixManager/my-cert/fullchain.pem
# TLS_KEY_FILE=/Library/Application Support/SentrySixManager/my-cert/privkey.pem
# Plain HTTP, only behind a reverse proxy that does HTTPS:
# TLS_MODE=off
# TRUST_PROXY=true
# Refuse requests for any other host name (DNS rebinding protection):
# TRUSTED_HOSTS=192.168.1.20,my-mac.local

# Create a first vehicle on first start (more can be added in Settings).
# VEHICLE_NAME=Daily Driver
# SMB_SHARE=//192.168.1.50/TeslaCam
# SMB_USERNAME=tesla
# SMB_PASSWORD=change-me
# SMB version: 3.1.1, 3.02, 3.0 or 3 (= 3.0 or newer); SMB 1/2 are not allowed.
# SMB_VERSION=3.1.1
# Encryption; false = signed only (others on the network could watch).
# SMB_ENCRYPT=true

# Settings > Updates asks GitHub twice a day whether a newer release is out
# (it never installs anything; you run sudo sentry-six-manager update).
# Turn it off:
# UPDATE_CHECK=off

# Extra folders the converter may write to, ':'-separated. Give the service
# access first: sudo sentry-six-manager allow-folder <folder> --write
# EXTRA_ROOTS=/Volumes/Converted

# Re-scan every vehicle this often (minutes).
# SCAN_INTERVAL_MINUTES=15

# Folders that folder vehicles may use, ':'-separated (a drive under
# /Volumes, or a folder in /Users/Shared). Give the service access first:
# sudo sentry-six-manager allow-folder <folder>
# FOLDER_ROOTS=/Volumes/TESLADRIVE
